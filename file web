// Proof next to the CTA: verified facts, plus confirmed claims when present.
function heroProof() {
  const items = [];
  if (confirmed.license || confirmed.insured)
    items.push(confirmed.license && confirmed.insured ? "Licensed & insured" : confirmed.license ? "Licensed plumbers" : "Fully insured");
  if (confirmed.upfrontPricing) items.push("You approve the price before work starts");
  items.push(`Locally owned, serving Syracuse since ${business.foundedYear}`, "Homes and businesses", "Syracuse & surrounding towns");
  return items.slice(0, 3);
}

