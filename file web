  );
}

import React, { useEffect, useMemo, useRef, useState } from "react";
import * as THREE from "three";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";
import { buildRun, buildTee, buildValveBody, buildLever, createGaugeTexture, psiToAngle } from "./geometry.js";

/*
 * Hero 3D scene: a copper supply line with a brass ball valve and a pressure
 * gauge. Loaded lazily (see HeroVisual.jsx), so three.js never touches the
 * main bundle or blocks the first paint.
 *
 * Interaction
 * - Desktop (fine pointer): the assembly turns slightly toward the cursor.
 * - Touch: a slow idle sway plus a small tilt as the page scrolls. Nothing
 *   captures touch, so scrolling is never blocked.
 * - Everyone: clicking/tapping the valve turns the lever a quarter turn and
 *   the gauge needle drops or rises, like the real thing.
 * - prefers-reduced-motion: rendered on demand, values snap, no idle motion.
 *   The setting is watched live, so changing it mid-visit takes effect at once.
 *
 * Audited against the ui-ux-pro-max three.js guidelines; see README.
 */

const PIPE_R = 0.2;
const BASE_ROT = { x: 0.2, y: -0.4 };
const BASE_POS = { x: -0.35, y: -0.28 };
const OPEN_PSI = 62;
const CLOSED_PSI = 6;
const VALVE_AT = new THREE.Vector3(-1.35, 0, 0);
const TEE_AT = new THREE.Vector3(0.75, 0, 0);
const GAUGE_AT = new THREE.Vector3(0.75, 1.1, 0);
const CAMERA_Z = 6.2;
// FOV 30 is deliberate: a long, flat "product photo" look. Wider angles
// exaggerate the pipe run receding to the left and distort the gauge.
const CAMERA_FOV = 30;

// Only the valve is interactive; skip raycasting for everything else.
const noRaycast = () => null;

/** Live media-query value (re-renders when the OS/browser setting changes). */
function useMediaQuery(query) {
  const [matches, setMatches] = useState(() => window.matchMedia(query).matches);
  useEffect(() => {
    const mq = window.matchMedia(query);
    const onChange = (e) => setMatches(e.matches);
    setMatches(mq.matches);
    mq.addEventListener("change", onChange);
    return () => mq.removeEventListener("change", onChange);
  }, [query]);
  return matches;
}

function useMaterials() {
  return useMemo(
    () => ({
      copper: new THREE.MeshPhysicalMaterial({ color: "#c47a4a", metalness: 1, roughness: 0.3, clearcoat: 0.25, clearcoatRoughness: 0.4 }),
      fitting: new THREE.MeshStandardMaterial({ color: "#b86c3c", metalness: 1, roughness: 0.4 }),
      solder: new THREE.MeshStandardMaterial({ color: "#b7b2a6", metalness: 1, roughness: 0.45 }),
      brass: new THREE.MeshStandardMaterial({ color: "#c9a25a", metalness: 1, roughness: 0.3 }),
      brassHex: new THREE.MeshStandardMaterial({ color: "#c9a25a", metalness: 1, roughness: 0.3, flatShading: true }),
      steel: new THREE.MeshStandardMaterial({ color: "#c5cbd0", metalness: 1, roughness: 0.25 }),
      grip: new THREE.MeshStandardMaterial({ color: "#b3271a", metalness: 0, roughness: 0.55 }),
      needle: new THREE.MeshStandardMaterial({ color: "#b3271a", metalness: 0.2, roughness: 0.5 }),
      glass: new THREE.MeshPhysicalMaterial({ color: "#ffffff", metalness: 0, roughness: 0.05, transparent: true, opacity: 0.12, clearcoat: 1 }),
    }),
    []
  );
}

// Studio-style reflections generated on the GPU: no HDR file to download.
function Environment() {
  const { gl, scene, invalidate } = useThree();
  useEffect(() => {
    const pmrem = new THREE.PMREMGenerator(gl);
    const room = new RoomEnvironment();
    const env = pmrem.fromScene(room, 0.04).texture;
    scene.environment = env;
    room.dispose?.();
    invalidate();
    return () => {
      scene.environment = null;
      env.dispose();
      pmrem.dispose();
    };
  }, [gl, scene, invalidate]);
  return null;
}

// Explicit framing: distance adapts to the canvas aspect ratio (R3F already
// keeps camera.aspect in sync via a ResizeObserver on the container).
function CameraRig() {
  const { camera, size, invalidate } = useThree();
  useEffect(() => {
    const aspect = size.width / size.height;
    camera.position.set(0, 0, CAMERA_Z * Math.max(1, 2 / aspect));
    camera.lookAt(0, 0, 0);
    camera.updateProjectionMatrix();
    invalidate();
  }, [camera, size, invalidate]);
  return null;
}

function Assembly({ reducedMotion, finePointer, onValveToggle, open }) {
  const m = useMaterials();
  const group = useRef();
  const lever = useRef();
  const needle = useRef();
  const pointer = useRef({ x: 0, y: 0 });
  const pointerOverCanvas = useRef(false);
  const needleState = useRef({ value: reducedMotion ? (open ? OPEN_PSI : CLOSED_PSI) : 0, velocity: 0 });
  const { gl, invalidate } = useThree();

  const geo = useMemo(() => {
    const hot = buildRun({ points: [new THREE.Vector3(-9, 0, 0), new THREE.Vector3(2.35, 0, 0), new THREE.Vector3(2.35, -6, 0)], radius: PIPE_R, bendRadius: 0.55 });
    // Background line: fewer radial segments (it's smaller, darker, farther).
    const cold = buildRun({ points: [new THREE.Vector3(-9, -0.55, -1.15), new THREE.Vector3(3.25, -0.55, -1.15), new THREE.Vector3(3.25, -6, -1.15)], radius: PIPE_R * 0.85, bendRadius: 0.5, radial: 16 });
    const tee = buildTee({ at: TEE_AT, radius: PIPE_R, branchTop: 0.62 });
    const valve = buildValveBody({ at: VALVE_AT, pipeRadius: PIPE_R });
    const leverGeo = buildLever(PIPE_R);
    const gaugeTex = createGaugeTexture();
    return { hot, cold, tee, valve, leverGeo, gaugeTex };
  }, []);

  // Dispose GPU resources on unmount.
  useEffect(
    () => () => {
      const { hot, cold, tee, valve, leverGeo, gaugeTex } = geo;
      [hot, cold, tee, valve, leverGeo].forEach((set) => Object.values(set).forEach((g) => g?.dispose?.()));
      gaugeTex.dispose();
      Object.values(m).forEach((mat) => mat.dispose());
    },
    [geo, m]
  );

  useEffect(() => {
    if (!finePointer || reducedMotion) return undefined;
    const onMove = (e) => {
      pointer.current.x = (e.clientX / window.innerWidth) * 2 - 1;
      pointer.current.y = (e.clientY / window.innerHeight) * 2 - 1;
    };
    window.addEventListener("pointermove", onMove, { passive: true });
    return () => window.removeEventListener("pointermove", onMove);
  }, [finePointer, reducedMotion]);

  // Rule 25–27: the scene keeps easing after the mouse stops, so the valve can
  // slide under a still cursor. Track whether the pointer is over the canvas
  // so hover can be re-tested each frame (cheap: only the valve is raycast).
  useEffect(() => {
    const el = gl.domElement;
    const enter = () => (pointerOverCanvas.current = true);
    const leave = () => (pointerOverCanvas.current = false);
    el.addEventListener("pointerenter", enter);
    el.addEventListener("pointerleave", leave);
    return () => {
      el.removeEventListener("pointerenter", enter);
      el.removeEventListener("pointerleave", leave);
    };
  }, [gl]);

  // When reduced motion switches on mid-visit, snap everything to its rest
  // pose and render one still frame. When it switches off, the animation
  // loop picks up smoothly from these values.
  useEffect(() => {
    if (!reducedMotion || !group.current) return;
    group.current.rotation.set(BASE_ROT.x, BASE_ROT.y, 0);
    group.current.position.set(BASE_POS.x, BASE_POS.y, 0);
    lever.current.rotation.y = open ? 0 : -Math.PI / 2;
    needleState.current = { value: open ? OPEN_PSI : CLOSED_PSI, velocity: 0 };
    needle.current.rotation.z = psiToAngle(needleState.current.value);
    pointer.current = { x: 0, y: 0 };
    invalidate();
  }, [reducedMotion, open, invalidate]);

  useFrame((state, rawDelta) => {
    if (reducedMotion) return;
    const dt = Math.min(rawDelta, 0.05); // no jump after a background tab
    const t = state.clock.elapsedTime;
    const g = group.current;

    let ty = BASE_ROT.y;
    let tx = BASE_ROT.x;
    if (finePointer) {
      ty += pointer.current.x * 0.22;
      tx += pointer.current.y * 0.1;
    } else {
      const scroll = Math.min(window.scrollY / 700, 1);
      ty += Math.sin(t * 0.45) * 0.05 + scroll * 0.18;
      tx += Math.sin(t * 0.33) * 0.025;
    }
    // damp = frame-rate-independent lerp for smooth pointer follow.
    g.rotation.y = THREE.MathUtils.damp(g.rotation.y, ty, 3, dt);
    g.rotation.x = THREE.MathUtils.damp(g.rotation.x, tx, 3, dt);
    g.position.y = BASE_POS.y + Math.sin(t * 0.6) * 0.03;

    lever.current.rotation.y = THREE.MathUtils.damp(lever.current.rotation.y, open ? 0 : -Math.PI / 2, 7, dt);

    // Needle on a light spring so it overshoots slightly, like a real gauge.
    const n = needleState.current;
    const target = open ? OPEN_PSI + Math.sin(t * 7) * 0.35 : CLOSED_PSI;
    n.velocity += (target - n.value) * 38 * dt;
    n.velocity *= Math.exp(-5.5 * dt);
    n.value += n.velocity * dt;
    needle.current.rotation.z = psiToAngle(n.value);

    // Re-run hover detection against the moved scene (desktop pointer only).
    if (finePointer && pointerOverCanvas.current) state.events.update?.();
  });

  const setCursor = (c) => () => (gl.domElement.style.cursor = c);
  const toggle = (e) => {
    e.stopPropagation();
    onValveToggle();
  };

  // Static mode (reduced motion) takes pose from props; animated mode from useFrame.
  const leverRest = reducedMotion ? (open ? 0 : -Math.PI / 2) : -Math.PI / 2;
  const needleRest = reducedMotion ? psiToAngle(open ? OPEN_PSI : CLOSED_PSI) : psiToAngle(0);
  const decor = { raycast: noRaycast };

  return (
    <group ref={group} rotation={[BASE_ROT.x, BASE_ROT.y, 0]} position={[BASE_POS.x, BASE_POS.y, 0]}>
      {/* Back line (cold) */}
      <mesh geometry={geo.cold.pipe} material={m.copper} {...decor} />
      <mesh geometry={geo.cold.fittings} material={m.fitting} {...decor} />
      <mesh geometry={geo.cold.solder} material={m.solder} {...decor} />

      {/* Front line (hot) */}
      <mesh geometry={geo.hot.pipe} material={m.copper} {...decor} />
      <mesh geometry={geo.hot.fittings} material={m.fitting} {...decor} />
      <mesh geometry={geo.hot.solder} material={m.solder} {...decor} />
      <mesh geometry={geo.tee.pipe} material={m.copper} {...decor} />
      <mesh geometry={geo.tee.fittings} material={m.fitting} {...decor} />
      <mesh geometry={geo.tee.solder} material={m.solder} {...decor} />

      {/* Ball valve: the only interactive part (click / tap) */}
      <group onClick={toggle} onPointerOver={setCursor("pointer")} onPointerOut={setCursor("")}>
        <mesh geometry={geo.valve.body} material={m.brass} />
        <mesh geometry={geo.valve.hexes} material={m.brassHex} />
        <group ref={lever} position={[VALVE_AT.x, geo.valve.stemTop, VALVE_AT.z]} rotation={[0, leverRest, 0]}>
          <mesh geometry={geo.leverGeo.arm} material={m.steel} />
          <mesh geometry={geo.leverGeo.nut} material={m.steel} />
          <mesh geometry={geo.leverGeo.grip} material={m.grip} />
          {/* Larger invisible hit area so the lever is easy to tap */}
          <mesh position={[0.6, 0, 0]} visible={false}>
            <boxGeometry args={[1.8, 0.5, 0.7]} />
          </mesh>
        </group>
      </group>

      {/* Pressure gauge on the tee branch */}
      <group position={GAUGE_AT}>
        <mesh position={[0, -0.5, 0]} material={m.brassHex} {...decor}>
          <cylinderGeometry args={[0.12, 0.12, 0.12, 6]} />
        </mesh>
        <mesh rotation={[Math.PI / 2, 0, 0]} material={m.steel} {...decor}>
          <cylinderGeometry args={[0.46, 0.46, 0.2, 48]} />
        </mesh>
        <mesh position={[0, 0, 0.1]} material={m.steel} {...decor}>
          <torusGeometry args={[0.46, 0.035, 12, 48]} />
        </mesh>
        <mesh position={[0, 0, 0.101]} {...decor}>
          <circleGeometry args={[0.43, 48]} />
          <meshStandardMaterial map={geo.gaugeTex} roughness={0.7} metalness={0} />
        </mesh>
        <group ref={needle} position={[0, 0, 0.115]} rotation={[0, 0, needleRest]}>
          <mesh position={[0, 0.13, 0]} material={m.needle} {...decor}>
            <boxGeometry args={[0.022, 0.32, 0.01]} />
          </mesh>
        </group>
        <mesh position={[0, 0, 0.12]} rotation={[Math.PI / 2, 0, 0]} material={m.steel} {...decor}>
          <cylinderGeometry args={[0.035, 0.035, 0.02, 16]} />
        </mesh>
        <mesh position={[0, 0, 0.13]} material={m.glass} {...decor}>
          <circleGeometry args={[0.44, 48]} />
        </mesh>
      </group>
    </group>
  );
}

export default function PipeScene({ active, onReady, onFail }) {
  const reducedMotion = useMediaQuery("(prefers-reduced-motion: reduce)");
  const finePointer = useMediaQuery("(hover: hover) and (pointer: fine)");
  // Reduced motion shows the valve open from the start; otherwise it opens
  // once, shortly after the scene appears.
  const [open, setOpen] = useState(reducedMotion);

  useEffect(() => {
    if (reducedMotion) {
      setOpen(true);
      return undefined;
    }
    const id = setTimeout(() => setOpen(true), 900);
    return () => clearTimeout(id);
  }, [reducedMotion]);

  // Render only while the hero is on screen; reduced motion renders on demand.
  const frameloop = reducedMotion ? "demand" : active ? "always" : "never";

  return (
    <Canvas
      frameloop={frameloop}
      dpr={[1, finePointer ? 2 : 1.5]}
      camera={{ fov: CAMERA_FOV, position: [0, 0, CAMERA_Z], near: 0.1, far: 50 }}
      gl={{ antialias: true, alpha: true, powerPreference: "high-performance" }}
      style={{ touchAction: "pan-y" }}
      onCreated={({ gl }) => {
        gl.domElement.addEventListener("webglcontextlost", (e) => {
          e.preventDefault();
          onFail?.();
        });
        onReady?.();
      }}
    >
      <Environment />
      <CameraRig />
      <ambientLight intensity={0.25} />
      <directionalLight position={[-3, 4, 5]} intensity={1.6} color="#ffe6cc" />
      <directionalLight position={[4, 1, -4]} intensity={1.1} color="#8fb5d4" />
      <Assembly reducedMotion={reducedMotion} finePointer={finePointer} open={open} onValveToggle={() => setOpen((o) => !o)} />
    </Canvas>
  );
}

