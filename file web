/**
 * The site's two conversion actions, ordered by what will actually work
 * right now: calling leads while the phones are staffed, the request form
 * leads while closed (a call then goes unanswered). Both stay available.
 */
export default function ContactActions({ tone = "light", requestHref = "#contact", large = false, showNote = false }) {
  const { isOpen, nextOpen } = useHoursStatus();
  const v = VARIANTS[tone];
  const size = large ? "btn--lg" : "";

  const call = (
    <Button key="call" href={business.phoneHref} variant={isOpen ? v.primary : v.secondary} icon={Phone} className={size}>
      Call {business.phone}
    </Button>
  );
  const request = (
    <Button key="request" href={requestHref} variant={isOpen ? v.secondary : v.primary} icon={ClipboardList} className={size}>
      Request Service
    </Button>
  );

  return (
    <div className="contact-actions">
      <div className="contact-actions__buttons">{isOpen ? [call, request] : [request, call]}</div>
      {showNote && !isOpen && (
        <p className="contact-actions__note">
          We're closed now and open {nextOpen}. A request you send now will be waiting for us when we open.
        </p>
      )}
    </div>
  );
}

