import * as THREE from "three";
import { mergeGeometries } from "three/addons/utils/BufferGeometryUtils.js";

/*
 * Procedural geometry for the hero pipe assembly. Everything is generated in
 * code (no model files to download), then merged into one geometry per
 * material so the whole scene draws in roughly a dozen calls.
 */

const UP = new THREE.Vector3(0, 1, 0);
const ONE = new THREE.Vector3(1, 1, 1);

// Places a Y-axis primitive so its axis points along `dir`, centred at `center`.
function orient(geometry, center, dir) {
  const q = new THREE.Quaternion().setFromUnitVectors(UP, dir.clone().normalize());
  geometry.applyMatrix4(new THREE.Matrix4().compose(center, q, ONE));
  return geometry;
}

function cylinderAlong(radius, length, center, dir, radial = 28) {
  return orient(new THREE.CylinderGeometry(radius, radius, length, radial, 1, false), center, dir);
}

function hexAlong(radius, length, center, dir) {
  // 6 radial segments + flat shading on the material reads as a machined nut.
  return orient(new THREE.CylinderGeometry(radius, radius, length, 6, 1, false), center, dir);
}

function ringAt(radius, tube, center, dir) {
  // Torus lies in XY by default (axis = Z); rotate that axis onto `dir`.
  const g = new THREE.TorusGeometry(radius, tube, 8, 36);
  const q = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir.clone().normalize());
  g.applyMatrix4(new THREE.Matrix4().compose(center, q, ONE));
  return g;
}

const merge = (list) => {
  // Drop the index so every primitive type merges cleanly.
  const geometries = list.map((g) => (g.index ? g.toNonIndexed() : g));
  geometries.forEach((g) => g.clearGroups());
  return mergeGeometries(geometries, false);
};

/**
 * A copper run: straight lengths joined by 90° bends. Each bend gets a
 * slightly larger sweat-elbow fitting with socket collars and solder beads,
 * the way real copper supply lines are assembled.
 */
export function buildRun({ points, radius, bendRadius, radial = 28 }) {
  const pipe = [];
  const fittings = [];
  const solder = [];
  const fitR = radius * 1.16;
  const socket = radius * 1.5;

  let cursor = points[0].clone();
  for (let i = 1; i < points.length - 1; i++) {
    const corner = points[i];
    const dirIn = corner.clone().sub(points[i - 1]).normalize();
    const dirOut = points[i + 1].clone().sub(corner).normalize();
    const a = corner.clone().addScaledVector(dirIn, -bendRadius);
    const b = corner.clone().addScaledVector(dirOut, bendRadius);

    pipe.push(new THREE.TubeGeometry(new THREE.LineCurve3(cursor, a), 1, radius, radial, false));
    const bend = new THREE.QuadraticBezierCurve3(a, corner.clone(), b);
    pipe.push(new THREE.TubeGeometry(bend, 24, radius, radial, false));

    // Elbow fitting body + a socket collar at each end.
    fittings.push(new THREE.TubeGeometry(bend, 24, fitR, radial, false));
    const endA = a.clone().addScaledVector(dirIn, -socket);
    const endB = b.clone().addScaledVector(dirOut, socket);
    fittings.push(cylinderAlong(fitR, socket, a.clone().addScaledVector(dirIn, -socket / 2), dirIn, radial));
    fittings.push(cylinderAlong(fitR, socket, b.clone().addScaledVector(dirOut, socket / 2), dirOut, radial));
    solder.push(ringAt(radius * 1.03, radius * 0.07, endA, dirIn));
    solder.push(ringAt(radius * 1.03, radius * 0.07, endB, dirOut));
    cursor = b;
  }
  pipe.push(new THREE.TubeGeometry(new THREE.LineCurve3(cursor, points[points.length - 1]), 1, radius, radial, false));

  return { pipe: merge(pipe), fittings: merge(fittings), solder: merge(solder) };
}

/** Copper tee on a horizontal run with a branch rising to the gauge. */
export function buildTee({ at, radius, branchTop }) {
  const fitR = radius * 1.16;
  const x = new THREE.Vector3(1, 0, 0);
  const len = radius * 3.4;
  const fittings = [
    cylinderAlong(fitR, len, at, x),
    cylinderAlong(fitR, radius * 1.9, at.clone().add(new THREE.Vector3(0, radius * 0.95, 0)), UP),
  ];
  const solder = [
    ringAt(radius * 1.03, radius * 0.07, at.clone().add(new THREE.Vector3(-len / 2, 0, 0)), x),
    ringAt(radius * 1.03, radius * 0.07, at.clone().add(new THREE.Vector3(len / 2, 0, 0)), x),
    ringAt(radius * 1.03, radius * 0.07, at.clone().add(new THREE.Vector3(0, radius * 1.9, 0)), UP),
  ];
  const branchLen = branchTop - at.y;
  const pipe = cylinderAlong(radius, branchLen, at.clone().add(new THREE.Vector3(0, branchLen / 2, 0)), UP);
  return { fittings: merge(fittings), solder: merge(solder), pipe: merge([pipe]) };
}

/** Brass ball-valve body (the lever is built separately so it can turn). */
export function buildValveBody({ at, pipeRadius }) {
  const x = new THREE.Vector3(1, 0, 0);
  const r = pipeRadius;
  const parts = [
    cylinderAlong(r * 1.55, r * 2.7, at, x, 32),
    new THREE.SphereGeometry(r * 1.85, 32, 20).translate(at.x, at.y, at.z),
    cylinderAlong(r * 0.62, r * 1.3, at.clone().add(new THREE.Vector3(0, r * 2.05, 0)), UP, 20),
  ];
  const hexes = [
    hexAlong(r * 1.62, r * 0.95, at.clone().add(new THREE.Vector3(-r * 1.85, 0, 0)), x),
    hexAlong(r * 1.62, r * 0.95, at.clone().add(new THREE.Vector3(r * 1.85, 0, 0)), x),
    hexAlong(r * 0.7, r * 0.45, at.clone().add(new THREE.Vector3(0, r * 2.75, 0)), UP),
  ];
  return { body: merge(parts), hexes: merge(hexes), stemTop: at.y + r * 3 };
}

/** Ball-valve lever: steel arm + vinyl grip, pivoting at the origin. */
export function buildLever(pipeRadius) {
  const r = pipeRadius;
  const arm = new THREE.BoxGeometry(r * 2.8, r * 0.22, r * 0.62).translate(r * 1.3, 0, 0);
  const nut = new THREE.CylinderGeometry(r * 0.42, r * 0.42, r * 0.34, 6).translate(0, r * 0.2, 0);
  const grip = new THREE.CapsuleGeometry(r * 0.36, r * 2.6, 6, 16);
  grip.rotateZ(Math.PI / 2);
  grip.scale(1, 0.62, 1);
  grip.translate(r * 3.6, 0, 0);
  return { arm: merge([arm]), nut: merge([nut]), grip };
}

/**
 * Gauge dial face drawn on a canvas. Ticks follow the same mapping the
 * needle uses: 0 psi at 225°, 100 psi at -45°.
 */
export function createGaugeTexture() {
  const size = 256;
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext("2d");
  const c = size / 2;

  ctx.fillStyle = "#f4f2ee";
  ctx.beginPath();
  ctx.arc(c, c, c, 0, Math.PI * 2);
  ctx.fill();

  // Operating band: a muted green arc for the normal house range (40–80 psi).
  ctx.lineWidth = 9;
  ctx.strokeStyle = "#5e8f6a";
  ctx.beginPath();
  const toRad = (v) => ((225 - v * 2.7) * Math.PI) / 180;
  ctx.arc(c, c, c * 0.8, -toRad(40), -toRad(80));
  ctx.stroke();

  ctx.strokeStyle = "#1a2530";
  ctx.fillStyle = "#1a2530";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.font = "600 21px Inter, Arial, sans-serif";
  for (let v = 0; v <= 100; v += 5) {
    const a = toRad(v);
    const major = v % 25 === 0;
    const r1 = c * 0.9;
    const r2 = c * (major ? 0.72 : 0.8);
    ctx.lineWidth = major ? 4 : 2;
    ctx.beginPath();
    ctx.moveTo(c + r1 * Math.cos(a), c - r1 * Math.sin(a));
    ctx.lineTo(c + r2 * Math.cos(a), c - r2 * Math.sin(a));
    ctx.stroke();
    if (major) ctx.fillText(String(v), c + c * 0.55 * Math.cos(a), c - c * 0.55 * Math.sin(a));
  }
  ctx.font = "700 20px Inter, Arial, sans-serif";
  ctx.fillText("PSI", c, c + c * 0.42);

  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = 4;
  return texture;
}

/** Needle rotation (radians, about Z) for a pressure in psi. */
export const psiToAngle = (psi) => THREE.MathUtils.degToRad(135 - psi * 2.7);

import React, { Component, Suspense, lazy, useEffect, useRef, useState } from "react";
import PipeAssemblyFallback from "./PipeAssemblyFallback.jsx";
import { detectHeroMode } from "../../lib/webgl.js";

// three.js + React Three Fiber live in their own chunk, fetched only on
// capable devices and only after the page is idle.
const PipeScene = lazy(() => import("./PipeScene.jsx"));

class SceneBoundary extends Component {
  state = { failed: false };
  static getDerivedStateFromError() {
    return { failed: true };
  }
  componentDidCatch() {
    this.props.onFail();
  }
  render() {
    return this.state.failed ? null : this.props.children;
  }
}

/**
 * The hero's 3D copper-line visual, with a matching SVG fallback.
 * Decorative only: hidden from assistive tech, and never needed to call or
 * request service.
 */
export default function HeroVisual() {
  const [mode] = useState(detectHeroMode);
  const [failed, setFailed] = useState(false);
  const [mounted, setMounted] = useState(false);
  const [shown, setShown] = useState(false);
  const [inView, setInView] = useState(true);
  const ref = useRef(null);
  const use3D = mode === "3d" && !failed;

  // Defer loading until the browser is idle so the headline, buttons, and
  // form are interactive first.
  useEffect(() => {
    if (!use3D) return undefined;
    if ("requestIdleCallback" in window) {
      const id = window.requestIdleCallback(() => setMounted(true), { timeout: 1500 });
      return () => window.cancelIdleCallback(id);
    }
    const id = setTimeout(() => setMounted(true), 400);
    return () => clearTimeout(id);
  }, [use3D]);

  // Pause rendering whenever the hero is scrolled out of view.
  useEffect(() => {
    if (!use3D || !ref.current || !("IntersectionObserver" in window)) return undefined;
    const observer = new IntersectionObserver(([entry]) => setInView(entry.isIntersecting), { rootMargin: "100px" });
    observer.observe(ref.current);
    return () => observer.disconnect();
  }, [use3D]);

  return (
    <div ref={ref} className={`hero__visual${shown ? " is-shown" : ""}`} aria-hidden="true" data-mode={use3D ? "3d" : "fallback"}>
      {use3D ? (
        mounted && (
          <SceneBoundary onFail={() => setFailed(true)}>
            <Suspense fallback={null}>
              <PipeScene active={inView} onReady={() => setShown(true)} onFail={() => setFailed(true)} />
            </Suspense>
          </SceneBoundary>
        )
      ) : (
        <PipeAssemblyFallback />
      )}
    </div>
  );
}

