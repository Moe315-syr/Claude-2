/**
 * Service request form.
 * - compact: name, phone, service (hero)
 * - full: adds email, address, and details (contact section)
 */
export default function RequestForm({ compact = false, idPrefix = "contact" }) {
  const { service, setService } = useRequest();
  const hours = useHoursStatus();
  const [values, setValues] = useState(EMPTY);
  const [errors, setErrors] = useState({});
  const [status, setStatus] = useState("idle"); // idle | submitting | success | error
  const successRef = useRef(null);

  const id = (field) => `${idPrefix}-${field}`;

  useEffect(() => {
    if (status === "success") successRef.current?.focus();
  }, [status]);

  const update = (field) => (event) => {
    const value = field === "phone" ? formatPhone(event.target.value) : event.target.value;
    setValues((prev) => ({ ...prev, [field]: value }));
    if (errors[field]) setErrors((prev) => ({ ...prev, [field]: undefined }));
  };

  function validate() {
    const next = {};
    if (!values.name.trim()) next.name = "Enter your name so we know who to ask for.";
    if (!isValidPhone(values.phone)) next.phone = "Enter a 10-digit phone number, like (315) 555-0147.";
    if (!compact && values.email && !/^\S+@\S+\.\S+$/.test(values.email))
      next.email = "Check the email address, or leave it blank.";
    return next;
  }

  async function handleSubmit(event) {
    event.preventDefault();
    const next = validate();
    setErrors(next);
    const firstInvalid = Object.keys(next)[0];
    if (firstInvalid) {
      document.getElementById(id(firstInvalid))?.focus();
      return;
    }
    setStatus("submitting");
    try {
      await submitRequest({
        ...values,
        service: service || "Not specified",
        source: compact ? "hero" : "contact",
        submittedAt: new Date().toISOString(),
      });
      trackEvent("lead_submit", { location: compact ? "hero" : "contact", service: service || "not_specified" });
      setStatus("success");
    } catch {
      setStatus("error");
    }
  }

  function reset() {
    setValues(EMPTY);
    setErrors({});
    setStatus("idle");
  }

  if (status === "success") {
    return (
      <div className="form-success" role="status" tabIndex={-1} ref={successRef}>
        <CheckCircle2 size={24} aria-hidden="true" />
        <div>
          <strong>Request sent.</strong>
          <p>
            We'll call you back at {values.phone} to set up a time.{" "}
            {hours.isOpen
              ? `If water is actively leaking, call ${business.phone} now.`
              : `We're closed now, and your request will be waiting for us when we open ${hours.nextOpen}.`}
          </p>
          <button type="button" className="link-button" onClick={reset}>
            Send another request
          </button>
        </div>
      </div>
    );
  }

  const inputProps = (field) => ({
    id: id(field),
    name: field,
    value: values[field],
    onChange: update(field),
    "aria-invalid": errors[field] ? "true" : undefined,
    "aria-describedby": errors[field] ? `${id(field)}-error` : undefined,
  });

  return (
    <form className={`request-form${compact ? " request-form--compact" : ""}`} onSubmit={handleSubmit} noValidate>
      <div className={compact ? "" : "form-row form-row--2"}>
        <Field id={id("name")} label="Your name" error={errors.name}>
          <input type="text" autoComplete="name" {...inputProps("name")} />
        </Field>
        <Field id={id("phone")} label="Phone number" error={errors.phone}>
          <input type="tel" inputMode="tel" autoComplete="tel" placeholder="(315) 555-0147" {...inputProps("phone")} />
        </Field>
      </div>

      {!compact && (
        <Field id={id("email")} label="Email" optional error={errors.email}>
          <input type="email" autoComplete="email" {...inputProps("email")} />
        </Field>
      )}

      <div className={compact ? "" : "form-row form-row--2"}>
        <Field id={id("service")} label="What do you need help with?">
          <select id={id("service")} name="service" value={service} onChange={(e) => setService(e.target.value)}>
            <option value="">Choose a service</option>
            {SERVICE_OPTIONS.map((option) => (
              <option key={option} value={option}>
                {option}
              </option>
            ))}
          </select>
        </Field>
        {!compact && (
          <Field id={id("address")} label="Service address" optional>
            <input type="text" autoComplete="street-address" {...inputProps("address")} />
          </Field>
        )}
      </div>

      {!compact && service === "Commercial Plumbing" && (
        <Field id={id("company")} label="Business name" optional>
          <input type="text" autoComplete="organization" {...inputProps("company")} />
        </Field>
      )}

      {!compact && (
        <Field id={id("details")} label="What's going on?" optional>
          <textarea placeholder="For example: the kitchen sink drains slowly and gurgles." {...inputProps("details")} />
        </Field>
      )}

      {status === "error" && (
        <p className="form-error" role="alert">
          <AlertCircle size={18} aria-hidden="true" />
          Your request didn't go through. Check your connection and try again, or call {business.phone}.
        </p>
      )}

      <Button type="submit" variant="primary" block disabled={status === "submitting"}>
        {status === "submitting" ? (
          <>
            <Loader2 size={20} className="spin" aria-hidden="true" /> Sending request…
          </>
        ) : (
          "Request Service"
        )}
      </Button>

      {/* The hero already shows the hours note beside this compact form */}
      {!(compact && !hours.isOpen) && <p className="form-note">
        {hours.isOpen ? (
          <>
            Water leaking right now?{" "}
            <a href={business.phoneHref}>
              <Phone size={13} aria-hidden="true" /> Call {business.phone}
            </a>
          </>
        ) : (
          `We're closed now and open ${hours.nextOpen}. Your request will be waiting for us.`
        )}
      </p>}
    </form>
  );
}

