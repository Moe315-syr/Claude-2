// Mobile-only bar that appears once the hero's own CTAs scroll out of view,
// and steps aside at the contact section so it never covers the form.
// Like ContactActions, it leads with whichever action works right now.
export default function StickyCallBar() {
  const [visible, setVisible] = useState(false);
  const { isOpen } = useHoursStatus();

  useEffect(() => {
    const hero = document.getElementById("top");
    const contact = document.getElementById("contact");
    if (!hero || !contact || !("IntersectionObserver" in window)) return undefined;
    const state = { heroVisible: true, contactVisible: false };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === hero) state.heroVisible = entry.isIntersecting;
        if (entry.target === contact) state.contactVisible = entry.isIntersecting;
      });
      setVisible(!state.heroVisible && !state.contactVisible);
    });
    observer.observe(hero);
    observer.observe(contact);
    return () => observer.disconnect();
  }, []);

  const tab = visible ? 0 : -1;
  const call = (
    <Button key="call" href={business.phoneHref} variant={isOpen ? "primary" : "light"} icon={Phone} tabIndex={tab}>
      Call Now
    </Button>
  );
  const request = (
    <Button key="request" href="#contact" variant={isOpen ? "light" : "primary"} icon={ClipboardList} tabIndex={tab}>
      Request Service
    </Button>
  );

  return (
    <div className={`sticky-call${visible ? " is-visible" : ""}`} aria-hidden={!visible} data-cta-zone="sticky-bar">
      {isOpen ? [call, request] : [request, call]}
    </div>
  );
}

