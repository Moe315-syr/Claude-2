// Formats digits as (315) 555-0147 while the user types.
export function formatPhone(value) {
  const digits = value.replace(/\D/g, "").replace(/^1(?=\d{10})/, "").slice(0, 10);
  if (digits.length < 4) return digits;
  if (digits.length < 7) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
  return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
}

export function isValidPhone(value) {
  return value.replace(/\D/g, "").length === 10;
}

/**
 * Sends a service request.
 *
 * Set VITE_FORM_ENDPOINT in a .env file to a JSON-accepting endpoint
 * (Formspree, Basin, a CRM webhook, or your own API) to go live:
 *
 *   VITE_FORM_ENDPOINT=https://formspree.io/f/yourFormId
 *
 * Without it, the site runs in demo mode: the request is logged to the
 * console and the success state is shown, so the flow can be reviewed.
 */
const ENDPOINT = import.meta.env.VITE_FORM_ENDPOINT;

export async function submitRequest(data) {
  if (!ENDPOINT) {
    await new Promise((resolve) => setTimeout(resolve, 700));
    console.info("[demo mode] Service request (set VITE_FORM_ENDPOINT to send):", data);
    return { ok: true, demo: true };
  }

  const response = await fetch(ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json", Accept: "application/json" },
    body: JSON.stringify(data),
  });
  if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
  return { ok: true };
}

/**
 * Decides whether this device should render the hero in 3D.
 *
 * Returns "3d" or "fallback". Falls back when:
 * - WebGL is unavailable, or only available through a slow software
 *   renderer (failIfMajorPerformanceCaveat)
 * - the visitor has Data Saver on
 * - the device reports very little memory
 *
 * For testing, add ?hero3d=off or ?hero3d=force to the URL.
 */
export function detectHeroMode() {
  if (typeof window === "undefined") return "fallback";
  const override = new URLSearchParams(window.location.search).get("hero3d");
  if (override === "off") return "fallback";

  const force = override === "force";
  if (!force) {
    if (navigator.connection?.saveData) return "fallback";
    if (typeof navigator.deviceMemory === "number" && navigator.deviceMemory < 2) return "fallback";
  }

  try {
    const canvas = document.createElement("canvas");
    const opts = force ? {} : { failIfMajorPerformanceCaveat: true };
    const gl = canvas.getContext("webgl2", opts) || canvas.getContext("webgl", opts);
    if (!gl) return "fallback";
    gl.getExtension("WEBGL_lose_context")?.loseContext(); // free the probe context
    return "3d";
  } catch {
    return "fallback";
  }
}

/**
 * Minimal conversion tracking. Loads nothing by itself: it forwards events to
 * Google Analytics (gtag) or Google Tag Manager (dataLayer) if the owner adds
 * either to index.html. Events:
 *   phone_call_click  { location }   a tel: link was tapped, and where
 *   lead_submit       { location, service }
 */
export function trackEvent(name, params = {}) {
  if (typeof window.gtag === "function") window.gtag("event", name, params);
  else if (Array.isArray(window.dataLayer)) window.dataLayer.push({ event: name, ...params });
  if (import.meta.env.DEV) console.info("[track]", name, params);
}

// One delegated listener covers every phone link on the site. The location
// comes from the nearest data-cta-zone, section id, header, or footer.
export function trackPhoneClicks() {
  document.addEventListener("click", (event) => {
    const link = event.target.closest('a[href^="tel:"]');
    if (!link) return;
    const zone = link.closest("[data-cta-zone], section[id], header, footer");
    const location = zone?.dataset.ctaZone || zone?.id || zone?.tagName.toLowerCase() || "unknown";
    trackEvent("phone_call_click", { location });
  });
}

import { business } from "../data/content.js";

const DAY_NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const SHORT = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

function formatHour(h) {
  const suffix = h >= 12 ? "PM" : "AM";
  const hour = h % 12 === 0 ? 12 : h % 12;
  return `${hour} ${suffix}`;
}

// Current day/minute in the business's own time zone, whatever the
// visitor's device is set to.
function nowInBusinessZone(date) {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: business.schedule.timeZone,
    weekday: "short",
    hour: "numeric",
    minute: "numeric",
    hourCycle: "h23",
  }).formatToParts(date);
  const get = (type) => parts.find((p) => p.type === type)?.value;
  return {
    day: SHORT.indexOf(get("weekday")),
    minutes: Number(get("hour")) * 60 + Number(get("minute")),
  };
}

/**
 * Returns { isOpen, label, nextOpen } for the business schedule.
 * label examples: "Open now until 8 PM", "Closed, opens tomorrow at 7 AM".
 */
export function getHoursStatus(date = new Date()) {
  const { days, openHour, closeHour } = business.schedule;
  const { day, minutes } = nowInBusinessZone(date);
  const openToday = days.includes(day);

  if (openToday && minutes >= openHour * 60 && minutes < closeHour * 60) {
    return { isOpen: true, label: `Open now until ${formatHour(closeHour)}`, nextOpen: null };
  }

  let nextOpen;
  if (openToday && minutes < openHour * 60) {
    nextOpen = `today at ${formatHour(openHour)}`;
  } else {
    for (let offset = 1; offset <= 7; offset++) {
      const d = (day + offset) % 7;
      if (days.includes(d)) {
        nextOpen = `${offset === 1 ? "tomorrow" : DAY_NAMES[d]} at ${formatHour(openHour)}`;
        break;
      }
    }
  }
  return { isOpen: false, label: `Closed, opens ${nextOpen}`, nextOpen };
}

import React, { createContext, useCallback, useContext, useMemo, useState } from "react";

const RequestContext = createContext(null);

/**
 * Shares the selected service between the service list and the request
 * forms, so "Request this service" pre-fills the form and takes the visitor
 * straight to it.
 */
export function RequestProvider({ children }) {
  const [service, setService] = useState("");

  const requestService = useCallback((title) => {
    setService(title);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.getElementById("contact")?.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
    window.setTimeout(
      () => document.getElementById("contact-name")?.focus({ preventScroll: true }),
      reduced ? 0 : 600
    );
  }, []);

  const value = useMemo(() => ({ service, setService, requestService }), [service, requestService]);
  return <RequestContext.Provider value={value}>{children}</RequestContext.Provider>;
}

export function useRequest() {
  const ctx = useContext(RequestContext);
  if (!ctx) throw new Error("useRequest must be used inside <RequestProvider>");
  return ctx;
}

# Syracuse Pro Plumbing — Website

A production-quality marketing website for Syracuse Pro Plumbing, built with
React + Vite. Mobile-first, fully responsive, and structured for fast edits
and easy handoff to a developer or agency.

## Run it locally

Requires [Node.js](https://nodejs.org) 18 or newer.

```bash
npm install
npm run dev
```

Then open the URL Vite prints (usually `http://localhost:5173`).

## Build for production

```bash
npm run build
```

This outputs a static site to `dist/` that can be deployed to any static
host (Netlify, Vercel, Cloudflare Pages, S3 + CloudFront, or a standard web
server). Preview the production build locally with:

```bash
npm run preview
```

## Project structure

```
src/
