/* =========================================================================
   SYRACUSE PRO PLUMBING — DESIGN TOKENS
   Ink-navy workwear + copper (the actual color of copper pipe) as the one
   accent reserved for calls-to-action. Red appears only in the emergency
   banner so it keeps its urgency.
   ========================================================================= */

:root {
  --ink: #0f2438;
  --deep: #163a5f;
  --copper: #b85d28;        /* darkened for 4.5:1 contrast with white text */
  --copper-light: #e08a4f;  /* accents on dark backgrounds */
  --cream: #f7f5f1;
  --white: #ffffff;
  --steel: #50606a;
  --steel-light: #dde2e5;
  --alert: #b3271a;
  --success: #2f7a3d;
  --error: #b3271a;

  --font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

  --max-width: 1200px;
  --header-h: 64px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

@media (min-width: 960px) {
  :root { --header-h: 76px; }
}

/* ---------- Reset & base ---------- */

*, *::before, *::after { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-h) + 12px);
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--ink);
  background: var(--cream);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 700;
  line-height: 1.05;
  margin: 0;
  color: inherit;
}

p { margin: 0; }
ul, ol { margin: 0; padding: 0; list-style: none; }
a { color: inherit; text-decoration: none; }
img, svg { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; }
blockquote, figure { margin: 0; }
[hidden] { display: none !important; }

:focus-visible {
  outline: 3px solid var(--copper-light);
  outline-offset: 3px;
  border-radius: 2px;
}

.skip-link {
  position: absolute;
  left: 12px;
  top: -60px;
  z-index: 100;
  background: var(--white);
  color: var(--ink);
  font-weight: 700;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  transition: top 0.15s var(--ease);
}
.skip-link:focus { top: 12px; }

/* ---------- Layout ---------- */

.container {
  width: 100%;
  max-width: var(--max-width);
  margin-inline: auto;
  padding-inline: 20px;
}
@media (min-width: 768px) { .container { padding-inline: 32px; } }

.section { padding-block: 64px; }
@media (min-width: 900px) { .section { padding-block: 96px; } }

.section--white { background: var(--white); }
.section--dark { background: var(--ink); color: var(--cream); }
.section--deep { background: var(--deep); color: var(--cream); }

.section-head { max-width: 640px; margin-bottom: 40px; }
.section-head--center { margin-inline: auto; text-align: center; }
.section-head h2 {
  font-size: clamp(2rem, 4.4vw, 2.9rem);
  margin-bottom: 14px;
  text-wrap: balance;
}
.section-head p { color: var(--steel); font-size: 1.08rem; max-width: 60ch; }
.section--dark .section-head p,
.section--deep .section-head p { color: #c3cfd9; }

.rule { border: none; border-top: 1px solid var(--steel-light); margin: 0; }

/* ---------- Buttons ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 48px;
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  letter-spacing: 0.2px;
  padding: 12px 24px;
  border-radius: var(--radius-sm);
  border: 2px solid transparent;
  transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease), color 0.15s var(--ease), transform 0.15s var(--ease);
  white-space: nowrap;
  text-align: center;
}
.btn:active { transform: translateY(1px); }
.btn svg { flex-shrink: 0; }
@media (max-width: 479px) { .btn { max-width: 100%; white-space: normal; } }
.btn:disabled { opacity: 0.75; cursor: progress; }

.btn--primary { background: var(--copper); border-color: var(--copper); color: var(--white); }
.btn--primary:hover { background: #a1501f; border-color: #a1501f; }

.btn--outline { background: transparent; border-color: rgba(255, 255, 255, 0.6); color: var(--white); }
.btn--outline:hover { border-color: var(--white); background: rgba(255, 255, 255, 0.08); }

.btn--dark { background: var(--ink); border-color: var(--ink); color: var(--white); }
.btn--dark:hover { background: var(--deep); border-color: var(--deep); }

.btn--light { background: var(--white); border-color: var(--white); color: var(--ink); }
.btn--light:hover { background: var(--cream); }

.btn--alert { background: var(--white); border-color: var(--white); color: var(--alert); }
.btn--alert:hover { background: transparent; color: var(--white); }

.btn--block { width: 100%; }
.btn--sm { min-height: 42px; font-size: 1.02rem; padding: 8px 18px; }
.btn--lg { min-height: 58px; font-size: 1.35rem; padding: 14px 30px; }

.link-button {
  background: none;
  border: none;
  padding: 0;
  margin-top: 10px;
  font-weight: 600;
  color: var(--copper);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.spin { animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- Header ---------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--ink);
  border-bottom: 3px solid var(--copper);
}

.site-header__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  height: var(--header-h);
}

.brand { display: flex; align-items: center; gap: 10px; color: var(--white); min-width: 0; }
.brand__mark { color: var(--copper-light); flex-shrink: 0; }
.brand__text { display: flex; flex-direction: column; min-width: 0; }
.brand__name {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  line-height: 0.95;
}
.site-header .brand__name > span { display: block; white-space: nowrap; }
@media (min-width: 480px) {
  .site-header .brand__name > span { display: inline; }
}
.brand__sub { display: none; font-size: 0.75rem; font-weight: 500; color: #9fb0bd; margin-top: 4px; }
@media (min-width: 480px) { .brand__name { font-size: 1.4rem; } }
@media (min-width: 1280px) { .brand__sub { display: block; } }

.site-header__nav { display: none; }
@media (min-width: 1140px) {
  .site-header__nav { display: flex; gap: 22px; }
  .site-header__nav a { color: #cfd8df; font-weight: 500; font-size: 0.93rem; padding-block: 6px; white-space: nowrap; }
  .site-header__nav a:hover { color: var(--white); }
}

.site-header__actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.header-call { display: flex; align-items: center; gap: 10px; color: var(--white); }
.header-call__icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--copper);
}
.header-call__text { display: none; font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; line-height: 1.1; }
.header-call__label { display: block; font-family: var(--font-body); font-size: 0.7rem; font-weight: 600; color: #9fb0bd; }
@media (min-width: 640px) {
  .header-call__text { display: block; }
  .header-call__icon { background: transparent; width: auto; height: auto; color: var(--copper-light); }
}

.header-request { display: none; }
@media (min-width: 960px) { .header-request { display: inline-flex; margin-left: 8px; } }

.header-menu-btn {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  color: var(--white);
}
@media (min-width: 1140px) { .header-menu-btn { display: none; } }

.mobile-nav { background: var(--deep); border-top: 1px solid rgba(255, 255, 255, 0.08); }
.mobile-nav nav { padding-block: 8px 20px; }
.mobile-nav a:not(.btn) {
  display: block;
  padding: 14px 0;
  color: var(--white);
  font-weight: 500;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.mobile-nav__ctas { display: grid; gap: 10px; margin-top: 18px; }
.is-menu-open .mobile-nav { animation: menu-in 0.2s var(--ease); }
@keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }

/* ---------- Hours status pill ---------- */

.hours-status {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 6px 14px 6px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #dbe3e9;
}
.hours-status__dot { width: 9px; height: 9px; border-radius: 50%; background: #9aa6ad; }
.hours-status.is-open .hours-status__dot { background: #4cc46a; box-shadow: 0 0 0 4px rgba(76, 196, 106, 0.2); }

/* ---------- Hours-aware contact actions ---------- */

.contact-actions { margin-bottom: 28px; }
.contact-actions__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
.contact-actions__buttons .btn { flex: 1 1 100%; }
@media (min-width: 480px) { .contact-actions__buttons .btn { flex: 0 1 auto; } }
.contact-actions__note { margin-top: 12px; font-size: 0.92rem; color: #b9c7d2; max-width: 48ch; }
.cta-row .contact-actions,
.emergency__actions .contact-actions { margin-bottom: 0; }

.hero__leak-link {
  display: inline-block;
  margin: -12px 0 24px;
  font-weight: 600;
  color: var(--copper-light);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.hero__leak-link:hover { color: var(--white); }

/* ---------- Hero ---------- */

.hero {
  position: relative;
  overflow: hidden;
  background: var(--ink);
  color: var(--white);
}

.hero__grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 36px;
  padding-block: 44px 52px;
}
@media (min-width: 960px) {
  .hero__grid {
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    align-items: start; /* the 3D stage can never push the primary CTA down */
    gap: 56px;
    padding-block: 72px 88px;
  }
}

.hero__copy > * { animation: rise 0.7s var(--ease) both; }
.hero__copy > :nth-child(2) { animation-delay: 0.08s; }
.hero__copy > :nth-child(3) { animation-delay: 0.16s; }
.hero__copy > :nth-child(4) { animation-delay: 0.24s; }
.hero__copy > :nth-child(5) { animation-delay: 0.32s; }
.hero__side { position: relative; animation: rise 0.8s var(--ease) 0.35s both; }
@keyframes rise { from { opacity: 0; transform: translateY(16px); } }

.hero h1 {
  font-size: clamp(2.2rem, 7.6vw, 4.6rem);
  line-height: 0.98;
  margin: 20px 0 20px;
  max-width: 16ch;
  text-wrap: balance;
}
/* Short or mid-width laptop screens: keep the call-to-action above the fold */
@media (min-width: 960px) and (max-width: 1199px), (min-width: 960px) and (max-height: 800px) {
  .hero h1 { font-size: clamp(2.6rem, 5.2vw, 3.6rem); }
}
.hero__lede { font-size: 1.12rem; color: #cfd8df; max-width: 52ch; margin-bottom: 28px; }
@media (min-width: 960px) { .hero__lede { font-size: 1.2rem; } }

.hero__reviews {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: -12px 0 22px;
  font-weight: 600;
  color: #f2c14e;
}
.hero__reviews:hover { text-decoration: underline; }

.hero__proof { display: grid; gap: 10px; }
.hero__proof li { display: flex; align-items: center; gap: 10px; color: #dbe3e9; font-weight: 500; }
.hero__proof svg { color: var(--copper-light); flex-shrink: 0; }

/* ---------- Hero 3D visual (and its SVG fallback) ---------- */

.hero__visual {
  position: relative;
  z-index: 0;
  height: 170px;
  margin: 0 -20px -34px;   /* bleeds to the screen edges on phones */
  overflow: hidden;
}
@media (min-width: 768px) { .hero__visual { height: 200px; margin-inline: -32px; } }
@media (min-width: 960px) {
  .hero__visual {
    height: 250px;
    margin: -64px 0 -62px -56px; /* reaches into the column gap; card overlaps the drop pipe */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24%);
    mask-image: linear-gradient(90deg, transparent 0, #000 24%);
  }
}
/* Shorter laptop screens: a smaller stage keeps the form higher up */
@media (min-width: 960px) and (max-width: 1199px), (min-width: 960px) and (max-height: 800px) {
  .hero__visual { height: 180px; margin-top: -40px; }
}
.hero__visual canvas {
  display: block;
  opacity: 0;
  transition: opacity 0.9s var(--ease);
  touch-action: pan-y; /* never blocks vertical scrolling on touch */
}
.hero__visual.is-shown canvas { opacity: 1; }
.pipe-fallback {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.hero__card {
  position: relative;
  z-index: 1; /* sits over the drop pipe, so the line "feeds" the form */
  background: var(--white);
  color: var(--ink);
  border-radius: var(--radius-md);
  border-top: 5px solid var(--copper);
  padding: 26px 22px 22px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}
@media (min-width: 480px) { .hero__card { padding: 30px 30px 26px; } }
.hero__card h2 { font-size: 1.8rem; margin-bottom: 4px; }
.hero__card > p { color: var(--steel); margin-bottom: 20px; font-size: 0.97rem; }

/* ---------- Trust strip ---------- */

.trust-strip { background: var(--deep); color: var(--white); }
.trust-strip__row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 16px; padding-block: 26px; }
@media (min-width: 900px) { .trust-strip__row { grid-template-columns: repeat(4, 1fr); padding-block: 30px; } }
.trust-point { display: flex; align-items: flex-start; gap: 12px; font-size: 0.85rem; color: #b9c7d2; line-height: 1.35; }
.trust-point svg { color: var(--copper-light); flex-shrink: 0; }
.trust-point strong { display: block; font-family: var(--font-display); font-size: 1.12rem; color: var(--white); margin-bottom: 2px; }

/* ---------- Services ---------- */

.services-list { display: grid; border-top: 1px solid var(--steel-light); }
@media (min-width: 760px) { .services-list { grid-template-columns: 1fr 1fr; } }

.service-row {
  display: flex;
  gap: 18px;
  padding: 26px 6px;
  border-bottom: 1px solid var(--steel-light);
  transition: background-color 0.2s var(--ease);
}
.service-row:hover { background: var(--white); }
@media (min-width: 760px) {
  .service-row { padding: 30px 28px; }
  .service-row:nth-child(odd) { border-right: 1px solid var(--steel-light); }
}

.service-row__icon {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  background: var(--ink);
  color: var(--copper-light);
}
.service-row--featured .service-row__icon { background: var(--alert); color: var(--white); }
.service-row h3 { font-size: 1.35rem; margin-bottom: 6px; }
.service-row p { color: var(--steel); font-size: 0.98rem; margin-bottom: 12px; }

.service-row__action {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 32px;
  background: none;
  border: none;
  padding: 0;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--copper);
}
.service-row__action svg { transition: transform 0.2s var(--ease); }
.service-row__action:hover { text-decoration: underline; text-underline-offset: 3px; }
.service-row__action:hover svg:last-child { transform: translateX(3px); }
.service-row--featured .service-row__action { color: var(--alert); }

/* ---------- Emergency ---------- */

.emergency { position: relative; overflow: hidden; background: var(--alert); color: var(--white); }
.emergency::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.08) 0 18px, transparent 18px 36px);
  pointer-events: none;
}
.emergency__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 22px;
  padding-block: 44px 0;
}
@media (min-width: 820px) {
  .emergency__inner { flex-direction: row; align-items: center; justify-content: space-between; }
}
.emergency__text { display: flex; align-items: flex-start; gap: 18px; }
.emergency__icon {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  animation: pulse-ring 2.2s var(--ease) infinite;
}
@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.35); }
  70%, 100% { box-shadow: 0 0 0 14px rgba(255, 255, 255, 0); }
}
.emergency h2 { font-size: clamp(1.6rem, 3.4vw, 2.1rem); margin-bottom: 6px; }
.emergency p { color: rgba(255, 255, 255, 0.92); max-width: 60ch; }
.leak-steps {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 14px;
  margin: 26px 0 28px;
}
@media (min-width: 860px) { .leak-steps { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
.leak-step {
  display: flex;
  gap: 14px;
  padding: 18px 20px;
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.18);
}
.leak-step__number {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--white);
  color: var(--alert);
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
}
.leak-step h3 { font-size: 1.3rem; margin-bottom: 4px; }
.leak-step p { font-size: 0.95rem; }
.emergency__actions { position: relative; z-index: 1; padding-bottom: 44px; }

/* ---------- About ---------- */

.about { display: grid; gap: 48px; align-items: center; }
@media (min-width: 900px) { .about { grid-template-columns: 1fr 1fr; gap: 64px; } }

.about__media { position: relative; }
.van-illustration { width: 100%; height: auto; border-radius: var(--radius-md); }
.about__badge {
  position: absolute;
  bottom: -20px;
  right: 16px;
  background: var(--copper);
  color: var(--white);
  border-radius: var(--radius-md);
  padding: 14px 20px;
  text-align: center;
  box-shadow: 0 12px 28px rgba(15, 36, 56, 0.3);
}
.about__badge strong { display: block; font-family: var(--font-display); font-size: 2.4rem; line-height: 1; }
.about__badge span { font-size: 0.8rem; font-weight: 600; }

.about__body h2 { font-size: clamp(2rem, 4.2vw, 2.7rem); margin-bottom: 18px; text-wrap: balance; }
.about__body p { color: var(--steel); margin-bottom: 16px; max-width: 62ch; }
.about__points { display: grid; gap: 12px; margin: 24px 0 28px; }
@media (min-width: 540px) { .about__points { grid-template-columns: 1fr 1fr; } }
.about__point { display: flex; align-items: flex-start; gap: 10px; font-weight: 500; }
.about__point svg { color: var(--copper); flex-shrink: 0; margin-top: 2px; }

.about__call {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--copper);
  border-bottom: 2px solid currentColor;
  padding-bottom: 2px;
}
.about__call:hover { color: #a1501f; }

/* ---------- Why choose us ---------- */

.why-grid {
  display: grid;
  gap: 1px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.12);
}
@media (min-width: 640px) { .why-grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1000px) { .why-grid { grid-template-columns: repeat(4, 1fr); } }
.why-card { background: var(--ink); padding: 30px 26px; }
.why-card__icon { color: var(--copper-light); margin-bottom: 16px; }
.why-card h3 { font-size: 1.3rem; margin-bottom: 8px; color: var(--white); }
.why-card p { color: #b9c7d2; font-size: 0.95rem; }

.cta-row {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-top: 44px;
}
@media (min-width: 820px) { .cta-row { flex-direction: row; align-items: center; justify-content: space-between; } }
.cta-row p { font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; color: var(--white); }
.cta-row__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
.cta-row__buttons .btn { flex: 1 1 220px; }

/* ---------- Service area ---------- */

.area-layout { display: grid; gap: 40px; }
@media (min-width: 900px) { .area-layout { grid-template-columns: 1fr 1fr; align-items: center; gap: 56px; } }
.area-map { width: 100%; height: auto; border-radius: var(--radius-md); }
.area-towns { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
@media (min-width: 480px) { .area-towns { grid-template-columns: repeat(3, 1fr); } }
.area-town { display: flex; align-items: center; gap: 8px; padding: 11px 0; border-bottom: 1px solid var(--steel-light); font-weight: 500; font-size: 0.96rem; }
.area-town svg { color: var(--copper); flex-shrink: 0; }
.area-note { margin: 22px 0 16px; color: var(--steel); }

/* ---------- Testimonials ---------- */

.placeholder-note {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--steel);
  background: var(--white);
  border: 1px dashed #b8c2c8;
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  margin: -16px 0 28px;
  max-width: fit-content;
}
.testimonial-grid { display: grid; gap: 22px; }
@media (min-width: 820px) { .testimonial-grid { grid-template-columns: repeat(3, 1fr); } }
.testimonial-grid > li { display: flex; }
.testimonial-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
  background: var(--white);
  border: 1px solid var(--steel-light);
  border-radius: var(--radius-md);
  padding: 28px 26px 22px;
}
.testimonial-card__stars { display: flex; gap: 3px; color: #d99a1e; }
.testimonial-card blockquote { flex-grow: 1; font-size: 1.05rem; line-height: 1.6; }
.testimonial-card blockquote p::before { content: "\201C"; }
.testimonial-card blockquote p::after { content: "\201D"; }
.testimonial-card__author {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-top: 16px;
  border-top: 1px solid var(--steel-light);
  font-size: 0.86rem;
  color: var(--steel);
}
.testimonial-card__author strong { display: block; font-size: 0.97rem; color: var(--ink); }
.testimonial-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--steel);
  border: 1px dashed #b8c2c8;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
}

/* ---------- FAQ ---------- */

.faq-layout { display: grid; gap: 36px; }
@media (min-width: 900px) { .faq-layout { grid-template-columns: 0.8fr 1.2fr; gap: 64px; align-items: start; } }
.faq-intro h2 { font-size: clamp(2rem, 4.2vw, 2.7rem); margin-bottom: 14px; }
.faq-intro p { color: var(--steel); margin-bottom: 24px; max-width: 40ch; }
@media (min-width: 900px) { .faq-intro { position: sticky; top: calc(var(--header-h) + 32px); } }

.faq-list { border-top: 1px solid var(--steel-light); }
.faq-item { border-bottom: 1px solid var(--steel-light); }
.faq-item h3 { font-size: inherit; }
.faq-item__question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: transparent;
  border: none;
  text-align: left;
  padding: 20px 4px;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
}
.faq-item__question:hover { color: var(--copper); }
.faq-item__icon { flex-shrink: 0; color: var(--copper); transition: transform 0.2s var(--ease); }
.faq-item[data-open="true"] .faq-item__icon { transform: rotate(45deg); }
